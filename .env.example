# Copy this file to .env and fill in real values. Never commit .env.

# --- Django core ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database ---
# Leave DATABASE_URL unset/commented out to use the local sqlite3 file
# during development. Example for Postgres:
# DATABASE_URL=postgres://savecircle:savecircle@localhost:5432/savecircle

# --- Email ---
# Defaults to the console backend in development (emails print to the terminal).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=SaveCircle <no-reply@savecircle.com>

# --- Redis / Celery / Channels (used from Phase 6 onward) ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- Platform defaults (overridable later from the Super Admin settings panel) ---
REFERRAL_RATE_PERCENT=0.5
MATURITY_BONUS_PERCENT=10
PLATFORM_FEE_PERCENT=1
